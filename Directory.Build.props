<Project>
  <!-- Module root build properties. -->
  <PropertyGroup>
    <!-- Define path of the parent Directory.Build.props. -->
    <ParentDirectoryBuildProps>$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))</ParentDirectoryBuildProps>
    <!-- Define paths of the Hexalith build props. -->
    <Hexalith1BuildBuildProps>$(MSBuildThisFileDirectory)references/Hexalith.Builds/Hexalith.Build.props</Hexalith1BuildBuildProps>
    <Hexalith2BuildBuildProps>$(MSBuildThisFileDirectory)../Hexalith.Builds/Hexalith.Build.props</Hexalith2BuildBuildProps>
    <Hexalith3BuildBuildProps>$(MSBuildThisFileDirectory)../../Hexalith.Builds/Hexalith.Build.props</Hexalith3BuildBuildProps>
    <!-- Resolve Hexalith.PolymorphicSerializations source path for root-level and nested layouts.
         Prefer the root references submodule; when it is not initialized, fall back to the
         parent-level sibling submodule. The Exists check on each path is sufficient — no
         .gitmodules guard is needed, so the sibling is used even when the parent is not a
         submodule host (e.g. standalone clones laid out as siblings). -->
    <HexalithPolymorphicSerializationsRoot Condition="'$(HexalithPolymorphicSerializationsRoot)' == '' and Exists('$(MSBuildThisFileDirectory)references/Hexalith.PolymorphicSerializations/src/libraries/Hexalith.PolymorphicSerializations/')">$(MSBuildThisFileDirectory)references/Hexalith.PolymorphicSerializations</HexalithPolymorphicSerializationsRoot>
    <HexalithPolymorphicSerializationsRoot Condition="'$(HexalithPolymorphicSerializationsRoot)' == '' and Exists('$(MSBuildThisFileDirectory)../Hexalith.PolymorphicSerializations/src/libraries/Hexalith.PolymorphicSerializations/')">$(MSBuildThisFileDirectory)../Hexalith.PolymorphicSerializations</HexalithPolymorphicSerializationsRoot>
  </PropertyGroup>

  <!-- Import the parent Directory.Build.props file if it exists -->
  <Import Project="$(ParentDirectoryBuildProps)" Condition="Exists('$(ParentDirectoryBuildProps)')" />

  <!-- Import the required Hexalith.Build.props file. -->
  <Import Project="$(Hexalith1BuildBuildProps)" Condition="Exists('$(Hexalith1BuildBuildProps)') And '$(HexalithBuildLoaded)' != 'true'" />
  <Import Project="$(Hexalith2BuildBuildProps)" Condition="Exists('$(Hexalith2BuildBuildProps)') And '$(HexalithBuildLoaded)' != 'true'" />
  <Import Project="$(Hexalith3BuildBuildProps)" Condition="'$(HexalithBuildLoaded)' != 'true'" />

  <PropertyGroup>
    <Product>Hexalith.Commons</Product>
    <RepositoryUrl>https://github.com/Hexalith/Hexalith.Commons</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Hexalith/Hexalith.Commons</PackageProjectUrl>
    <PackageTags>hexalith;commons;utilities</PackageTags>
    <Description>Common utilities and helpers for Hexalith projects</Description>
  </PropertyGroup>
</Project>
