<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <IsPublishable>false</IsPublishable>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Authors>Hexalith Contributors</Authors>
    <Company>Hexalith</Company>
    <Product>Hexalith.Commons</Product>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Hexalith/Hexalith.Commons</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Hexalith/Hexalith.Commons</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>hexalith;commons;publication;transport;dotnet</PackageTags>
  </PropertyGroup>
</Project>
