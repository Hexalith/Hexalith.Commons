<Project>
  <!--
    Self-contained build properties for Hexalith.Commons.UniqueIds.

    This promoted helper is consumed from umbrella repositories that initialize only
    root-level submodules. Keeping the props local avoids importing Commons' nested
    Hexalith.Builds submodule while preserving the load-bearing build settings.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <IsPublishable>false</IsPublishable>
    <Authors>Hexalith Contributors</Authors>
    <Company>Hexalith</Company>
    <Product>Hexalith.Commons</Product>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Hexalith/Hexalith.Commons</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Hexalith/Hexalith.Commons</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>hexalith;commons;uniqueids;ulid;guid;identifiers;dotnet</PackageTags>
  </PropertyGroup>
</Project>
