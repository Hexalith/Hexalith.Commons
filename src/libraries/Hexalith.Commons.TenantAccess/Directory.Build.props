<Project>
  <!--
    Self-contained build properties for Hexalith.Commons.TenantAccess.

    This project is consumed from umbrella repositories that initialize only root-level
    submodules. Keeping the props local avoids importing Commons' nested Hexalith.Builds
    submodule while still allowing source references to root-level Tenants/EventStore.
  -->
  <PropertyGroup>
    <HexalithTenantsRoot Condition="'$(HexalithTenantsRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\..\..\Hexalith.Tenants\src\Hexalith.Tenants.Client')">$(MSBuildThisFileDirectory)..\..\..\..\Hexalith.Tenants</HexalithTenantsRoot>
    <HexalithTenantsRoot Condition="'$(HexalithTenantsRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\..\..\..\Hexalith.Tenants\src\Hexalith.Tenants.Client')">$(MSBuildThisFileDirectory)..\..\..\..\..\Hexalith.Tenants</HexalithTenantsRoot>
    <HexalithEventStoreRoot Condition="'$(HexalithEventStoreRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\..\..\Hexalith.EventStore\src\Hexalith.EventStore.Client')">$(MSBuildThisFileDirectory)..\..\..\..\Hexalith.EventStore</HexalithEventStoreRoot>
    <HexalithEventStoreRoot Condition="'$(HexalithEventStoreRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\..\..\..\Hexalith.EventStore\src\Hexalith.EventStore.Client')">$(MSBuildThisFileDirectory)..\..\..\..\..\Hexalith.EventStore</HexalithEventStoreRoot>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <IsPublishable>false</IsPublishable>
    <Authors>Hexalith Contributors</Authors>
    <Company>Hexalith</Company>
    <Product>Hexalith.Commons</Product>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Hexalith/Hexalith.Commons</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Hexalith/Hexalith.Commons</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>hexalith;commons;tenant-access;multitenancy;dependencyinjection;dotnet</PackageTags>
  </PropertyGroup>
</Project>
